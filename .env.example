# 伺服器
PORT=3000
NODE_ENV=production

# Session（請換成隨機長字串）
SESSION_SECRET=change-this-to-a-random-secret-string

# 初始超級管理員（首次啟動時若 admin_users 為空則自動建立）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Google OAuth（至 Google Cloud Console 申請）
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 格式：https://你的網域/auth/google/callback
GOOGLE_CALLBACK_URL=https://imgflow.jeremyhuang.com/auth/google/callback
