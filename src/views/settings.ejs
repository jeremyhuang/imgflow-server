<%- include('partials/header') %>

<% if (saved) { %>
  <div class="alert alert-success">設定已儲存。</div>
<% } %>

<form method="post" action="/admin/settings">
  <div class="card" style="max-width:600px;">
    <h3 style="margin:0 0 20px;">Google OAuth 設定</h3>
    <p style="color:#666;font-size:13px;margin-bottom:20px;">
      至 <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a>
      建立 OAuth 用戶端 ID 後填入。應用程式類型選「網頁應用程式」，
      已授權的重新導向 URI 填入下方的 Callback URL。
    </p>

    <div class="form-group">
      <label>Client ID</label>
      <input type="text" name="google_client_id"
             value="<%= settings.google_client_id %>"
             placeholder="xxx.apps.googleusercontent.com"
             class="form-control">
    </div>

    <div class="form-group" style="margin-top:16px;">
      <label>Client Secret</label>
      <input type="password" name="google_client_secret"
             value="<%= settings.google_client_secret %>"
             placeholder="GOCSPX-..."
             class="form-control">
    </div>

    <div class="form-group" style="margin-top:16px;">
      <label>服務網域</label>
      <input type="url" name="google_domain" id="google-domain"
             value="<%= domain %>"
             placeholder="https://imgflow.example.com"
             class="form-control">
      <p style="font-size:12px;color:#888;margin-top:4px;">
        Callback URL（請複製此值填入 Google Cloud Console）：<br>
        <code id="callback-preview" style="user-select:all;"><%= domain ? domain.replace(/\/$/, '') + '/auth/google/callback' : '（請先填入服務網域）' %></code>
      </p>
    </div>

    <script>
      document.getElementById('google-domain').addEventListener('input', function () {
        var v = this.value.replace(/\/$/, '');
        document.getElementById('callback-preview').textContent =
          v ? v + '/auth/google/callback' : '（請先填入服務網域）';
      });
    </script>

    <div style="margin-top:24px;">
      <button type="submit" class="btn btn-primary">儲存設定</button>
    </div>
  </div>
</form>

<%- include('partials/footer') %>
