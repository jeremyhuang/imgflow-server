<%- include('partials/header') %>

<div style="display:grid;grid-template-columns:1fr 360px;gap:24px;align-items:start;">

  <div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>帳號</th><th>角色</th><th>最後登入</th><th>狀態</th><th>操作</th></tr>
        </thead>
        <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><strong><%= user.username %></strong></td>
            <td><span class="badge badge-trial"><%= user.role === 'superadmin' ? '超級管理員' : '管理員' %></span></td>
            <td><%= user.last_login_at || '從未登入' %></td>
            <td><span class="badge <%= user.is_active ? 'badge-active' : 'badge-inactive' %>"><%= user.is_active ? '啟用' : '停用' %></span></td>
            <td>
              <% if (user.id !== admin.id) { %>
              <form method="post" action="/admin/users/<%= user.id %>/toggle" style="display:inline;">
                <button class="btn btn-sm btn-secondary"><%= user.is_active ? '停用' : '啟用' %></button>
              </form>
              <% } else { %>
              <span style="color:#aaa;font-size:12px;">（目前帳號）</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <div class="form-card">
      <h3 style="margin:0 0 16px;font-size:15px;">新增管理員</h3>
      <form method="post" action="/admin/users/create">
        <div class="form-group">
          <label>帳號</label>
          <input type="text" name="username" required>
        </div>
        <div class="form-group">
          <label>密碼</label>
          <div style="display:flex;gap:6px;align-items:center;">
            <input type="password" id="pw-new-user" name="password" required minlength="8" style="flex:1;">
            <button type="button" onclick="var i=document.getElementById('pw-new-user');i.type=i.type==='password'?'text':'password'"
                    style="padding:6px 10px;border:1px solid #ddd;border-radius:4px;background:#fff;cursor:pointer;color:#888;line-height:0;"
                    title="顯示 / 隱藏">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div class="form-group">
          <label>角色</label>
          <select name="role">
            <option value="admin">管理員</option>
            <option value="superadmin">超級管理員</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">建立帳號</button>
      </form>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
