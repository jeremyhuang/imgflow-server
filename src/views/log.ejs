<%- include('partials/header') %>

<%
function fmtBytes(b) {
  if (!b) return '0 B';
  var u = ['B','KB','MB','GB'];
  var i = Math.floor(Math.log(b) / Math.log(1024));
  return (b / Math.pow(1024, i)).toFixed(1) + ' ' + u[i];
}

var ACTION_COLORS = { compress: '#4c7df4', watermark: '#f59e0b', webp: '#10b981' };
var ACTION_LABELS = { compress: '壓縮', watermark: '浮水印', webp: 'WebP' };

function qs(overrides) {
  var parts = [];
  var clientId = overrides.client_id !== undefined ? overrides.client_id : filter_client;
  var acts     = overrides.actions    !== undefined ? overrides.actions    : filter_actions;
  var pg       = overrides.page       !== undefined ? overrides.page       : '';
  if (clientId) parts.push('client_id=' + encodeURIComponent(clientId));
  (acts || []).forEach(function(a) { parts.push('action=' + encodeURIComponent(a)); });
  if (pg) parts.push('page=' + pg);
  return parts.length ? '?' + parts.join('&') : '';
}
%>

<!-- 篩選列 -->
<form method="get" action="/admin/log" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
  <select name="client_id" class="form-control" style="min-width:160px;padding:5px 8px;border:1px solid #ddd;border-radius:4px;font-size:13px;">
    <option value="">全部客戶</option>
    <% clients.forEach(function(c) { %>
      <option value="<%= c.id %>" <%= filter_client === c.id ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>

  <div style="display:flex;gap:10px;align-items:center;padding:5px 10px;border:1px solid #ddd;border-radius:4px;background:#fff;font-size:13px;">
    <span style="color:#888;margin-right:2px;">操作</span>
    <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
      <input type="checkbox" name="action" value="compress"  <%= filter_actions.includes('compress')  ? 'checked' : '' %>> 壓縮
    </label>
    <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
      <input type="checkbox" name="action" value="watermark" <%= filter_actions.includes('watermark') ? 'checked' : '' %>> 浮水印
    </label>
    <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
      <input type="checkbox" name="action" value="webp"      <%= filter_actions.includes('webp')      ? 'checked' : '' %>> WebP
    </label>
  </div>

  <button type="submit" class="btn btn-primary btn-sm">套用篩選</button>

  <% if (filter_client || filter_actions.length) { %>
    <a href="/admin/log" class="btn btn-secondary btn-sm">清除篩選</a>
  <% } %>

  <span style="margin-left:auto;font-size:13px;color:#666;">共 <%= total %> 筆記錄</span>
</form>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>時間</th>
        <th>客戶</th>
        <th>檔案</th>
        <th>操作</th>
        <th>輸入</th>
        <th>輸出</th>
        <th>WebP</th>
        <th>耗時</th>
      </tr>
    </thead>
    <tbody>
    <% if (!logs.length) { %>
      <tr><td colspan="8" class="empty-cell">尚無記錄</td></tr>
    <% } %>
    <% logs.forEach(function(log) {
      var actions = [];
      try { actions = JSON.parse(log.actions_json || '[]'); } catch(e) {}
    %>
      <tr>
        <td style="white-space:nowrap;font-size:12px;color:#555;"><%= log.created_at ? log.created_at.slice(0,16).replace('T',' ') : '—' %></td>
        <td style="font-size:13px;">
          <div><a href="/admin/log?client_id=<%= log.client_id || '' %>" style="color:inherit;text-decoration:none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'"><%= log.client_name %></a></div>
          <div style="font-size:11px;color:#999;"><%= log.client_email %></div>
        </td>
        <td style="font-size:12px;max-width:240px;">
          <div style="display:flex;align-items:center;gap:8px;">
            <% if (log.source_url) { %>
              <div style="flex-shrink:0;width:38px;height:38px;border-radius:4px;overflow:hidden;position:relative;">
                <img src="<%= log.source_url %>" alt=""
                     style="width:38px;height:38px;object-fit:cover;display:block;"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                <div style="display:none;width:38px;height:38px;background:#f1f3f4;align-items:center;justify-content:center;border-radius:4px;" title="圖片已刪除或無法存取">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5" fill="#9ca3af" stroke="none"/>
                    <polyline points="21 15 16 10 5 21"/>
                    <line x1="3" y1="21" x2="21" y2="3"/>
                  </svg>
                </div>
              </div>
              <a href="<%= log.source_url %>" target="_blank" style="color:#4c7df4;word-break:break-all;"><%= log.filename || log.source_url.split('/').pop() %></a>
            <% } else { %>
              <div style="flex-shrink:0;width:38px;height:38px;background:#f1f3f4;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c4c9d4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5" fill="#c4c9d4" stroke="none"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
              <span style="color:#888;word-break:break-all;"><%= log.filename || '—' %></span>
            <% } %>
          </div>
        </td>
        <td>
          <% actions.forEach(function(a) { %>
            <span style="display:inline-block;padding:1px 7px;border-radius:3px;font-size:11px;color:#fff;background:<%= ACTION_COLORS[a] || '#888' %>;margin:1px;">
              <%= ACTION_LABELS[a] || a %>
            </span>
          <% }) %>
        </td>
        <td style="font-size:12px;white-space:nowrap;"><%= fmtBytes(log.input_size) %></td>
        <td style="font-size:12px;white-space:nowrap;"><%= fmtBytes(log.output_size) %></td>
        <td style="font-size:12px;white-space:nowrap;"><%= log.webp_size ? fmtBytes(log.webp_size) : '—' %></td>
        <td style="font-size:12px;white-space:nowrap;color:#666;"><%= log.processing_ms %> ms</td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<% if (total_pages > 1) { %>
<div style="display:flex;gap:6px;margin-top:16px;align-items:center;">
  <% if (current_page > 1) { %>
    <a href="<%= qs({ page: current_page - 1 }) %>" class="btn btn-sm btn-secondary">‹ 上一頁</a>
  <% } %>
  <span style="font-size:13px;color:#666;">第 <%= current_page %> / <%= total_pages %> 頁</span>
  <% if (current_page < total_pages) { %>
    <a href="<%= qs({ page: current_page + 1 }) %>" class="btn btn-sm btn-secondary">下一頁 ›</a>
  <% } %>

</div>
<% } %>

<%- include('partials/footer') %>
