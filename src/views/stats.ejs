<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<%
function fmtBytes(b) {
  if (!b) return '—';
  const units = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(b) / Math.log(1024));
  return (b / Math.pow(1024, i)).toFixed(1) + ' ' + units[i];
}
%>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
  <div class="card">
    <h3 style="margin:0 0 16px;font-size:14px;color:#666;">近 30 天每日處理張數</h3>
    <canvas id="dailyChart" height="130"></canvas>
  </div>
  <div class="card">
    <h3 style="margin:0 0 16px;font-size:14px;color:#666;">近 6 個月月度張數</h3>
    <canvas id="monthlyChart" height="130"></canvas>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>客戶</th><th>Email</th><th>方案</th><th>本月張數</th><th>原始大小</th><th>壓縮後</th></tr>
    </thead>
    <tbody>
    <% if (!topClients.length) { %>
      <tr><td colspan="6" class="empty-cell">本月尚無使用記錄</td></tr>
    <% } %>
    <% topClients.forEach(c => { %>
      <tr>
        <td><%= c.name %></td>
        <td><%= c.email %></td>
        <td><%= c.tier %></td>
        <td><%= c.count.toLocaleString() %></td>
        <td><%= fmtBytes(c.total_input) %></td>
        <td><%= fmtBytes(c.total_output) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<script>
const daily   = <%- daily %>;
const monthly = <%- monthly %>;

new Chart(document.getElementById('dailyChart'), {
  type: 'bar',
  data: {
    labels:   daily.map(d => d.day),
    datasets: [{ label: '張數', data: daily.map(d => d.count), backgroundColor: '#4c7df4', borderRadius: 4 }],
  },
  options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
});

new Chart(document.getElementById('monthlyChart'), {
  type: 'bar',
  data: {
    labels:   monthly.map(d => d.month),
    datasets: [{ label: '張數', data: monthly.map(d => d.count), backgroundColor: '#00b894', borderRadius: 4 }],
  },
  options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
});
</script>

<%- include('partials/footer') %>
