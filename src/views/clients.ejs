<%- include('partials/header') %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>客戶</th>
        <th>Email</th>
        <th>方案</th>
        <th>本月用量</th>
        <th>API Key</th>
        <th>狀態</th>
        <th>外掛設定</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
    <% if (!clients.length) { %>
      <tr><td colspan="8" class="empty-cell">尚無客戶</td></tr>
    <% } %>
    <% clients.forEach(client => { %>
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:8px;">
            <% if (client.avatar_url) { %>
              <img src="<%= client.avatar_url %>" style="width:28px;height:28px;border-radius:50%;">
            <% } %>
            <span><%= client.name %></span>
          </div>
        </td>
        <td><%= client.email %></td>
        <td>
          <form method="post" action="/admin/clients/<%= client.id %>/tier" style="margin:0;">
            <select name="tier_id" onchange="this.form.submit()" class="tier-select">
              <% tiers.forEach(t => { %>
                <option value="<%= t.id %>" <%= t.id === client.tier_id ? 'selected' : '' %>><%= t.name %></option>
              <% }) %>
            </select>
          </form>
        </td>
        <td><%= client.monthly_usage.toLocaleString() %> 次</td>
        <td>
          <% if (client.api_key) { %>
            <div style="display:flex;align-items:center;gap:6px;">
              <span class="key-display" data-key="<%= client.api_key %>"
                    style="font-family:monospace;font-size:12px;letter-spacing:1px;">●●●●●●●●</span>
              <button type="button" class="btn btn-sm btn-secondary key-toggle-btn"
                      onclick="toggleKey(this)" style="padding:2px 8px;font-size:11px;">顯示</button>
            </div>
          <% } else { %>
            <span style="color:#999;font-size:12px;">尚未設定</span>
          <% } %>
        </td>
        <td>
          <span class="badge <%= client.is_active ? 'badge-active' : 'badge-inactive' %>">
            <%= client.is_active ? '啟用' : '停用' %>
          </span>
        </td>
        <td>
          <% if (client.settings_json) { %>
            <button type="button" class="btn btn-sm btn-secondary"
                    onclick="showSettings(<%= client.id %>, this.dataset.s, this.dataset.t)"
                    data-s="<%= client.settings_json %>"
                    data-t="<%= client.settings_updated_at || '' %>">查看設定</button>
          <% } else { %>
            <span style="color:#999;font-size:12px;">尚無</span>
          <% } %>
        </td>
        <td>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <a href="/admin/log?client_id=<%= client.id %>" class="btn btn-sm btn-secondary">處理記錄</a>
            <form method="post" action="/admin/clients/<%= client.id %>/toggle" style="margin:0;">
              <button class="btn btn-sm <%= client.is_active ? 'btn-secondary' : 'btn-primary' %>">
                <%= client.is_active ? '停用' : '啟用' %>
              </button>
            </form>
            <form method="post" action="/admin/clients/<%= client.id %>/key/reset" style="margin:0;"
                  onsubmit="return confirm('重置後舊 Key 立即失效，客戶需重新綁定。確定？')">
              <button class="btn btn-sm btn-danger">重置 Key</button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<!-- 外掛設定 Modal -->
<div id="settings-modal-overlay" class="modal-overlay" style="display:none;" onclick="if(event.target===this)closeSettings()">
  <div class="modal" style="max-width:580px;width:92%;max-height:88vh;display:flex;flex-direction:column;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;flex-shrink:0;">
      <h3 style="margin:0;" id="settings-modal-title">外掛設定</h3>
      <button type="button" class="btn btn-sm btn-secondary" onclick="closeSettings()">✕ 關閉</button>
    </div>
    <p id="settings-updated-at" style="margin:0 0 14px;font-size:12px;color:#aaa;flex-shrink:0;"></p>
    <div id="settings-body" style="overflow-y:auto;flex:1;"></div>
  </div>
</div>

<script>
function toggleKey(btn) {
  var span = btn.previousElementSibling;
  if (btn.textContent === '顯示') {
    span.textContent = span.dataset.key;
    btn.textContent = '隱藏';
  } else {
    span.textContent = '●●●●●●●●';
    btn.textContent = '顯示';
  }
}

var MODE_LABELS  = { async: '非同步', sync: '同步' };
var POS_LABELS   = { tl:'左上',tc:'上中',tr:'右上',ml:'中左',mc:'正中',mr:'中右',bl:'左下',bc:'下中',br:'右下' };

function badge(ok) {
  return ok
    ? '<span style="display:inline-block;padding:1px 8px;border-radius:3px;font-size:11px;background:#d1fae5;color:#065f46;">是</span>'
    : '<span style="display:inline-block;padding:1px 8px;border-radius:3px;font-size:11px;background:#f3f4f6;color:#6b7280;">否</span>';
}

function row(label, val) {
  return '<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid #f3f4f6;">' +
    '<span style="color:#6b7280;font-size:13px;">' + label + '</span>' +
    '<span style="font-size:13px;font-weight:500;text-align:right;max-width:60%;">' + val + '</span></div>';
}

function section(title) {
  return '<div style="margin:14px 0 6px;font-size:11px;font-weight:700;letter-spacing:.08em;color:#9ca3af;text-transform:uppercase;">' + title + '</div>';
}

function wmBlock(cfg) {
  if (!cfg || typeof cfg !== 'object') return '<span style="color:#ccc;">未設定</span>';
  var sm = cfg.size_mode === 'scale'    ? '比例 ' + (cfg.scale||20) + '%'
         : cfg.size_mode === 'custom'   ? '自訂 ' + (cfg.custom_width||300) + 'px'
         : '原始尺寸';
  return '<div style="background:#f9fafb;border-radius:6px;padding:8px 12px;font-size:12px;margin-top:4px;">' +
    '<div style="display:flex;gap:16px;flex-wrap:wrap;">' +
    '<span><span style="color:#9ca3af;">位置</span> ' + (POS_LABELS[cfg.pos] || cfg.pos) + '</span>' +
    '<span><span style="color:#9ca3af;">大小</span> ' + sm + '</span>' +
    '<span><span style="color:#9ca3af;">透明度</span> ' + (cfg.opacity||100) + '%</span>' +
    '<span><span style="color:#9ca3af;">邊距</span> ' + (cfg.margin_x||0) + '% / ' + (cfg.margin_y||0) + '%</span>' +
    '</div></div>';
}

function showSettings(id, jsonStr, updatedAt) {
  var s;
  try { s = JSON.parse(jsonStr); } catch(e) { alert('設定資料解析失敗'); return; }

  var html = '';

  // ── 壓縮
  html += section('壓縮設定');
  html += row('JPEG 壓縮品質',    (s.jpeg_quality ?? '—') + (s.jpeg_quality ? ' %' : ''));
  html += row('WebP 品質',        (s.webp_quality ?? '—') + (s.webp_quality ? ' %' : ''));
  html += row('輸出 WebP',        badge(s.output_webp));
  html += row('壓縮子尺寸',       badge(s.compress_all_sizes));
  html += row('上傳時自動壓縮',   badge(s.compress_on_upload));
  html += row('處理模式',         MODE_LABELS[s.process_mode] || s.process_mode || '—');

  // ── 浮水印
  html += section('浮水印設定');
  html += row('啟用浮水印',       badge(s.watermark_enabled));
  html += row('最小套用寬度',     s.watermark_min_width ? s.watermark_min_width + ' px' : '—');
  if (s.watermark_image_url) {
    html += row('浮水印圖片',
      '<a href="' + s.watermark_image_url + '" target="_blank" style="word-break:break-all;font-size:12px;">' +
      s.watermark_image_url.split('/').pop() + '</a>');
  }
  html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px;">';
  html += '<div><div style="font-size:12px;color:#6b7280;margin-bottom:2px;">橫向</div>' + wmBlock(s.watermark_land) + '</div>';
  html += '<div><div style="font-size:12px;color:#6b7280;margin-bottom:2px;">直向</div>'  + wmBlock(s.watermark_port) + '</div>';
  html += '</div>';

  document.getElementById('settings-body').innerHTML = html;
  document.getElementById('settings-updated-at').textContent = updatedAt ? '最後同步：' + updatedAt : '';
  document.getElementById('settings-modal-overlay').style.display = 'flex';
}

function closeSettings() {
  document.getElementById('settings-modal-overlay').style.display = 'none';
}
</script>

<%- include('partials/footer') %>
