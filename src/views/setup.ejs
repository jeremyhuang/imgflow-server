<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <title>初始設定 — ImgFlow</title>
  <link rel="stylesheet" href="/admin/admin.css">
</head>
<body class="login-page">
  <div class="login-wrap">
    <div class="login-card">
      <div class="login-logo">ImgFlow</div>
      <div class="login-sub">建立第一個管理員帳號</div>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="post" action="/admin/setup">
        <div class="form-group">
          <label>帳號</label>
          <input type="text" name="username" required autofocus autocomplete="username">
        </div>
        <div class="form-group">
          <label>密碼（至少 8 個字元）</label>
          <div style="display:flex;gap:6px;align-items:center;">
            <input type="password" id="pw-password" name="password" required autocomplete="new-password" style="flex:1;">
            <button type="button" onclick="togglePw('pw-password')"
                    style="padding:6px 10px;border:1px solid #ddd;border-radius:4px;background:#fff;cursor:pointer;color:#888;line-height:0;"
                    title="顯示 / 隱藏">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div class="form-group">
          <label>確認密碼</label>
          <div style="display:flex;gap:6px;align-items:center;">
            <input type="password" id="pw-confirm" name="confirm" required autocomplete="new-password" style="flex:1;">
            <button type="button" onclick="togglePw('pw-confirm')"
                    style="padding:6px 10px;border:1px solid #ddd;border-radius:4px;background:#fff;cursor:pointer;color:#888;line-height:0;"
                    title="顯示 / 隱藏">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <script>
          function togglePw(id) {
            var inp = document.getElementById(id);
            inp.type = inp.type === 'password' ? 'text' : 'password';
          }
        </script>
        <button type="submit" class="btn btn-primary" style="width:100%;margin-top:4px;">建立帳號</button>
      </form>
    </div>
  </div>
</body>
</html>
